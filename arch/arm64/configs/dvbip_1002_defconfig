# DVBIP-1002: kernel configuration is kept identical to DVBIP-1004 so both
# boards share one feature set (S/PDIF optical output, RTL8822BU WiFi, SysRq
# off, Bluetooth off). Only the release string and the board specific PHY LED
# differ.
CONFIG_LOCALVERSION="-dvbip-1002"
CONFIG_HISTB_RTL8211F_LED=y
CONFIG_DVB_HI3130=m
CONFIG_MEDIA_TUNER_R858=m

CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m

CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTW88=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8822B=m
CONFIG_RTW88_8822BU=m

CONFIG_SND_SOC_SPDIF=m

CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0

# CONFIG_BT is not set
