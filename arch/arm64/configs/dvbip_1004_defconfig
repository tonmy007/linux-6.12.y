CONFIG_LOCALVERSION="-dvbip-1004"
CONFIG_DVB_HI3130=m
CONFIG_MEDIA_TUNER_R858=m

# --- Docker / container runtime support ---
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_INGRESS=m
CONFIG_IP_VS=m
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m

# --- Realtek RTL8822BU USB WiFi (0bda:802.11ac NIC) ---
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTW88=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8822B=m
CONFIG_RTW88_8822BU=m

# --- S/PDIF (optical / coaxial) output ---
CONFIG_SND_SOC_SPDIF=m

# The UART RX line floats when no serial cable is attached.  PL011
# decodes the resulting noise as SysRq presses, and the multi-page
# HELP dump blocks the console long enough for the SP805 watchdog to
# reset the board before the display ever comes up.  The box has no
# keyboard, so start with SysRq off instead of enabling it and
# disabling it again from systemd-sysctl a second later.
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0

# Bluetooth is deliberately disabled: the box is driven by the IR remote and
# the RTL8822BU combo radio showed no usable HID pairing path.
# CONFIG_BT is not set
